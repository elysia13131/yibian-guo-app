# 环境配置
# ENVIRONMENT=development  # 或 production

# Database
# 开发环境使用 SQLite
# DATABASE_URL=sqlite:///./learning.db
# 生产环境使用 PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/learning_platform

# JWT 签名密钥（生产环境请更换为随机长字符串）
SECRET_KEY=your-secret-key-change-in-production

# AI
DEEPSEEK_API_KEYS_STR=your_deepseek_api_keys_comma_separated
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MINICPM_API_KEY=your_minicpm_api_key
MINICPM_API_BASE=https://api.modelbest.co/v1

# 博查网页搜索（多个 Key 用英文逗号分隔）
BOCHA_API_KEYS_STR=key1,key2

# 火山引擎 TTS（语音合成）
TTS_SERVER_API_KEY=your_volcano_tts_api_key
TTS_APP_ID=your_tts_app_id
TTS_ACCESS_TOKEN=your_tts_access_token

# 文档解析 SoMark
SOMARK_API_KEYS_STR=your_somark_api_keys

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8000

# SMTP 邮箱（验证码）
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_smtp_authorization_code

# CORS
# 开发环境
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000,capacitor://localhost
# 生产环境
# CORS_ORIGINS=https://yourdomain.com,capacitor://localhost
